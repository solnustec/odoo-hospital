<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Token Usage Tree View -->
    <record id="hospital_chatbot_ai_usage_view_tree" model="ir.ui.view">
        <field name="name">hospital.chatbot.ai.token.usage.tree</field>
        <field name="model">hospital.chatbot.ai.token.usage</field>
        <field name="arch" type="xml">
            <tree string="Uso de tokens IA" create="0">
                <field name="timestamp"/>
                <field name="chatbot_id"/>
                <field name="session_id"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
                <field name="total_tokens"/>
                <field name="api_calls"/>
                <field name="estimated_cost" widget="monetary"
                       options="{'currency_id': False}"/>
            </tree>
        </field>
    </record>

    <!-- AI Token Daily Summary Tree View -->
    <record id="hospital_chatbot_ai_daily_view_tree" model="ir.ui.view">
        <field name="name">hospital.chatbot.ai.token.daily.tree</field>
        <field name="model">hospital.chatbot.ai.token.daily</field>
        <field name="arch" type="xml">
            <tree string="Resumen diario de tokens" create="0">
                <field name="date"/>
                <field name="chatbot_id"/>
                <field name="total_tokens"/>
                <field name="api_calls"/>
                <field name="unique_sessions"/>
                <field name="estimated_cost" widget="monetary"
                       options="{'currency_id': False}"/>
            </tree>
        </field>
    </record>

    <!-- AI Token Daily Graph View -->
    <record id="hospital_chatbot_ai_daily_view_graph" model="ir.ui.view">
        <field name="name">hospital.chatbot.ai.token.daily.graph</field>
        <field name="model">hospital.chatbot.ai.token.daily</field>
        <field name="arch" type="xml">
            <graph string="Uso diario de tokens" type="bar">
                <field name="date" type="col"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_chatbot_ai_usage" model="ir.actions.act_window">
        <field name="name">Uso de tokens IA</field>
        <field name="res_model">hospital.chatbot.ai.token.usage</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_chatbot_ai_daily" model="ir.actions.act_window">
        <field name="name">Resumen diario IA</field>
        <field name="res_model">hospital.chatbot.ai.token.daily</field>
        <field name="view_mode">tree,graph</field>
    </record>

    <!-- Menu items -->
    <menuitem id="chatbot_menu_ai_usage"
              name="Uso de tokens IA"
              parent="chatbot_menu_reports"
              action="action_chatbot_ai_usage"
              sequence="10"/>

    <menuitem id="chatbot_menu_ai_daily"
              name="Resumen diario IA"
              parent="chatbot_menu_reports"
              action="action_chatbot_ai_daily"
              sequence="20"/>
</odoo>
