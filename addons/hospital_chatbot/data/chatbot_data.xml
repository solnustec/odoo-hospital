<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Webhook secret config parameter -->
        <record id="chatbot_webhook_secret" model="ir.config_parameter">
            <field name="key">hospital_chatbot.webhook_secret</field>
            <field name="value">change-me-in-production</field>
        </record>

        <!-- Gemini API key config parameter -->
        <record id="chatbot_gemini_api_key" model="ir.config_parameter">
            <field name="key">hospital_chatbot.gemini_api_key</field>
            <field name="value"></field>
        </record>

        <!-- WhatsApp service URL (chatbot_listener, port 3500) -->
        <record id="chatbot_whatsapp_service_url" model="ir.config_parameter">
            <field name="key">hospital_chatbot.whatsapp_service_url</field>
            <field name="value">https://apiwhatsapp.solnustec.com</field>
        </record>
    </data>

    <data noupdate="0">
        <!-- WhatsApp login URL (loginqr, port 3100) -->
        <record id="chatbot_whatsapp_login_url" model="ir.config_parameter">
            <field name="key">hospital_chatbot.whatsapp_login_url</field>
            <field name="value">http://localhost:3100</field>
        </record>

        <!-- WhatsApp check session URL (check_session, port 3400) -->
        <record id="chatbot_whatsapp_check_url" model="ir.config_parameter">
            <field name="key">hospital_chatbot.whatsapp_check_url</field>
            <field name="value">http://localhost:3400</field>
        </record>
    </data>
</odoo>
