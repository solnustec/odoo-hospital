<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Test Wizard Form -->
    <record id="chatbot_test_wizard_form" model="ir.ui.view">
        <field name="name">hospital.chatbot.test.wizard.form</field>
        <field name="model">hospital.chatbot.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Probar Chatbot">
                <group>
                    <field name="chatbot_id"/>
                    <field name="phone_number"/>
                </group>
                <group>
                    <div class="d-flex gap-2 align-items-end" colspan="2">
                        <field name="message" placeholder="Escribe un mensaje..."
                               class="flex-grow-1" nolabel="1"/>
                        <button name="action_send" type="object" string="Enviar"
                                class="btn-primary" icon="fa-paper-plane"/>
                    </div>
                </group>
                <group string="Respuestas del bot">
                    <field name="response_display" nolabel="1" colspan="2"/>
                </group>
                <group string="Estado de sesión">
                    <field name="session_info" nolabel="1" colspan="2" widget="text"/>
                </group>
                <footer>
                    <button name="action_reset_session" type="object"
                            string="Reiniciar sesión" class="btn-warning"
                            icon="fa-refresh"
                            confirm="¿Reiniciar la sesión de prueba?"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Test Wizard Action -->
    <record id="action_chatbot_test_wizard" model="ir.actions.act_window">
        <field name="name">Probar Chatbot</field>
        <field name="res_model">hospital.chatbot.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add access rule for wizard -->
    <!-- Note: access is inherited from chatbot_security groups -->
</odoo>
