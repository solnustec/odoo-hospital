<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_qr_wizard_form" model="ir.ui.view">
        <field name="name">hospital.chatbot.whatsapp.qr.wizard.form</field>
        <field name="model">hospital.chatbot.whatsapp.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="Conectar WhatsApp">
                <group>
                    <field name="phone_number" readonly="1"/>
                    <field name="status_message" readonly="1"
                           decoration-success="status_message and 'Conectado' in status_message"
                           decoration-warning="status_message and 'Escanee' in status_message"
                           decoration-danger="status_message and 'Error' in status_message"/>
                </group>
                <group invisible="not qr_image">
                    <div colspan="2" class="text-center">
                        <field name="qr_image" widget="image"
                               class="d-block mx-auto"
                               options="{'size': [300, 300]}"/>
                        <p class="text-muted mt-2">
                            Abra WhatsApp en su teléfono → Dispositivos vinculados → Vincular un dispositivo
                        </p>
                    </div>
                </group>
                <footer>
                    <button name="action_check_connected" type="object"
                            string="Ya escaneé, verificar"
                            class="btn-primary" icon="fa-check"/>
                    <button name="action_refresh_qr" type="object"
                            string="Nuevo QR" class="btn-secondary"
                            icon="fa-refresh"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
