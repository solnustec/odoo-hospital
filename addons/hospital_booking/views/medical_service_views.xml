<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medical Service Tree View (editable) -->
    <record id="view_medical_service_tree" model="ir.ui.view">
        <field name="name">medical.service.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Servicios Médicos" editable="bottom">
                <field name="name" string="Servicio"/>
                <field name="list_price" string="Precio"/>
                <field name="taxes_id" widget="many2many_tags" string="Impuestos"/>
                <field name="categ_id" column_invisible="1"/>
                <field name="type" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Medical Service Form View (simplified) -->
    <record id="view_medical_service_form" model="ir.ui.view">
        <field name="name">medical.service.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Servicio Médico">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del servicio"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="list_price" string="Precio"/>
                            <field name="taxes_id" widget="many2many_tags"
                                   string="Impuestos"/>
                        </group>
                        <group>
                            <field name="type" invisible="1"/>
                            <field name="categ_id" invisible="1"/>
                            <field name="description_sale"
                                   placeholder="Descripción del servicio (visible en facturas)..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medical Service Action -->
    <record id="action_medical_services" model="ir.actions.act_window">
        <field name="name">Servicios Médicos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="[('categ_id', '=', ref('product_category_medical_service'))]"/>
        <field name="context" eval="{'default_type': 'service', 'default_categ_id': ref('product_category_medical_service')}"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_medical_service_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_medical_service_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un servicio médico
            </p>
            <p>Defina los servicios que ofrece el hospital (consultas, procedimientos, etc.)
            con su precio e impuestos.</p>
        </field>
    </record>
</odoo>
