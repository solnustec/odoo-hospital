    <!-- ==================== -->
    <!-- Resource Calendars   -->
    <!-- ==================== -->

    <!-- Morning doctor: Mon-Fri 07:00-13:00 -->
    <record id="calendar_morning" model="resource.calendar">
        <field name="name">Horario Matutino</field>
        <field name="tz">America/Guayaquil</field>
    </record>
    <record id="att_morning_mon" model="resource.calendar.attendance">
        <field name="name">Lunes</field>
        <field name="calendar_id" ref="calendar_morning"/>
        <field name="dayofweek">0</field>
        <field name="hour_from">7.0</field>
        <field name="hour_to">13.0</field>
        <field name="day_period">morning</field>
    </record>
    <record id="att_morning_tue" model="resource.calendar.attendance">
        <field name="name">Martes</field>
        <field name="calendar_id" ref="calendar_morning"/>
        <field name="dayofweek">1</field>
        <field name="hour_from">7.0</field>
        <field name="hour_to">13.0</field>
        <field name="day_period">morning</field>
    </record>
    <record id="att_morning_wed" model="resource.calendar.attendance">
        <field name="name">Miércoles</field>
        <field name="calendar_id" ref="calendar_morning"/>
        <field name="dayofweek">2</field>
        <field name="hour_from">7.0</field>
        <field name="hour_to">13.0</field>
        <field name="day_period">morning</field>
    </record>
    <record id="att_morning_thu" model="resource.calendar.attendance">
        <field name="name">Jueves</field>
        <field name="calendar_id" ref="calendar_morning"/>
