        <field name="name">Viernes</field>
        <field name="calendar_id" ref="calendar_morning"/>
        <field name="dayofweek">4</field>
        <field name="hour_from">7.0</field>
        <field name="hour_to">13.0</field>
        <field name="day_period">morning</field>
    </record>

